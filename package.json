{
  "name": "wiki-tours",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/ingest-articles.mjs",
    "build": "next build --turbopack",
    "postbuild": "npm run seo:suite && npm test",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./tests/register.mjs --test tests/months.test.mjs tests/offers.test.mjs tests/authors.test.mjs",
    "schema:audit": "node scripts/schema-audit.mjs",
    "seo:suite": "node --import ./tests/register.mjs scripts/seo-suite.mjs",
    "seo:audit": "node scripts/seo-audit.js",
    "i18n:audit": "node scripts/i18n-audit.mjs",
