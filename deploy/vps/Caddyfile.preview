# PREVIEW mode (before the DNS cut-over). Installed by bootstrap.sh.
# - The server's own Hostinger name gets a real certificate, so the owner can open the site in a
#   browser before any DNS change. It is never indexed.
# - The real hostnames still point at Vercel, so they get Caddy's INTERNAL certificate here and
#   are tested with:  curl -k --resolve wikitours.ma:443:<VPS IP> https://wikitours.ma/fr
# - The app is reached as localhost:3000 (it listens on [::1]; see wikitours.service).
# Keep the snippets identical to the production Caddyfile.
{
	# No admin API: no local process (build scripts, the app) can reconfigure Caddy or read its
	# keys through it. Config changes need `systemctl restart caddy` (a reload uses the API).
	admin off
	# tls internal: never try to add Caddy's local CA to the system trust store (the caddy user cannot).
	skip_install_trust
}

(app) {
	# Vercel refused request bodies over 4.5 MB before the app saw them; keep a similar ceiling.
	request_body {
		max_size 5MB
	}
	# The app trusts Vercel's geo headers; a client must not be able to send them through.
	request_header -X-Vercel-Ip-Country
	request_header -X-Vercel-Ip-Country-Region
	request_header -X-Vercel-Ip-City
	# Vercel never exposed Next's internal rewrite header (it names the /admin rewrite).
	header -X-Middleware-Rewrite
	# Browsers get HTML/RSC the way Vercel's CDN served them: "public, max-age=0, must-revalidate".
	# Next's "s-maxage=…, stale-while-revalidate=…" is a CDN header; a browser honours the SWR part
	# and would show a stale page (prices, seats) on a repeat visit. /_next/static and /_next/image
	# carry other values and keep them.
	header >Cache-Control "^s-maxage=\d+(, stale-while-revalidate=\d+)?$" "public, max-age=0, must-revalidate"
	# HSTS on every response, redirects included (Next sets it on pages; this fills the gaps).
	header ?Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	# TRACE/TRACK have no use here (Next answered them 500).
	@trace method TRACE TRACK
	respond @trace 405
	encode zstd gzip
	# A deploy restarts the single Node process (~1 s). Keep retrying the upstream instead of
	# answering 502 meanwhile (Vercel deploys were atomic).
	reverse_proxy localhost:3000 {
		lb_try_duration 15s
		lb_try_interval 250ms
		# Node closes an idle keep-alive connection after 5 s. Caddy must drop it first: reusing a
		# connection at the moment Node closes it fails a POST (a lead form) with 502, and only GETs
		# are retried.
		transport http {
			keepalive 4s
		}
	}
}

# Legacy hosts: the middleware matcher skips files, /api and /_next, so on bab-makka.com they would
# be served directly (robots.txt, sitemap.xml, llms.txt…). Send them to the canonical site as well.
(legacy_files) {
	@legacy_file path_regexp \.[A-Za-z0-9]+$
	redir @legacy_file https://wikitours.ma{uri} 301
	@legacy_internal path /_next/* /api/*
	redir @legacy_internal https://wikitours.ma{uri} 301
}

srv2062670.hstgr.cloud {
	header X-Robots-Tag "noindex, nofollow"
	import app
}

# www → apex here, not in the middleware: behind a proxy request.nextUrl carries the internal port,
# so the middleware's host swap produced https://wikitours.ma:3000/… . 301 = what Vercel answers today.
www.wikitours.ma {
	tls internal
	header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	redir https://wikitours.ma{uri} 301
}

wikitours.ma, admin.wikitours.ma {
	tls internal
	import app
}

bab-makka.com, www.bab-makka.com, m.bab-makka.com {
	tls internal
	import legacy_files
	import app
}
