# PREVIEW mode (before the DNS cut-over). Installed by bootstrap.sh.
# - The server's own Hostinger name gets a real certificate, so the owner can open the site in a
#   browser before any DNS change. It is never indexed.
# - The real hostnames still point at Vercel, so they get Caddy's INTERNAL certificate here and
#   are tested with:  curl -k --resolve wikitours.ma:443:<VPS IP> https://wikitours.ma/fr
# - The app is reached as localhost:3000 (it listens on [::1]; see wikitours.service).
{
	# No admin API: no local process (build scripts, the app) can reconfigure Caddy or read its
	# keys through it. Config changes need `systemctl restart caddy` (a reload uses the API).
	admin off
	# tls internal: never try to add Caddy's local CA to the system trust store (the caddy user cannot).
	skip_install_trust
}

(app) {
	# Vercel refused request bodies over 4.5 MB before the app saw them; keep a similar ceiling.
	request_body {
		max_size 5MB
	}
	# The app trusts Vercel's geo headers; a client must not be able to send them through.
	request_header -X-Vercel-Ip-Country
	request_header -X-Vercel-Ip-Country-Region
	request_header -X-Vercel-Ip-City
	# Vercel never exposed Next's internal rewrite header (it names the /admin rewrite).
	header -X-Middleware-Rewrite
	encode zstd gzip
	# A deploy restarts the single Node process (~1 s). Keep retrying the upstream instead of
	# answering 502 meanwhile (Vercel deploys were atomic).
	reverse_proxy localhost:3000 {
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

srv2062670.hstgr.cloud {
	header X-Robots-Tag "noindex, nofollow"
	import app
}

# www → apex here, not in the middleware: behind a proxy request.nextUrl carries the internal port,
# so the middleware's host swap produced https://wikitours.ma:3000/… . 301 = what Vercel answers today.
www.wikitours.ma {
	tls internal
	redir https://wikitours.ma{uri} 301
}

wikitours.ma, admin.wikitours.ma, bab-makka.com, www.bab-makka.com, m.bab-makka.com {
	tls internal
	import app
}
