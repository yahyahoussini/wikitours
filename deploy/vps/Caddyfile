# PRODUCTION mode (after the DNS cut-over). Copy to /etc/caddy/Caddyfile, then
#   touch /etc/caddy/.wikitours-production && systemctl restart caddy
# Caddy gets and renews the Let's Encrypt certificates for every hostname by itself.
# The Next.js middleware does admin.wikitours.ma → /admin and bab-makka.com (+ www, m) →
# wikitours.ma/fr/… (one 301). www.wikitours.ma → apex is done HERE (301, as Vercel did), because
# behind a proxy the middleware's host swap kept the internal :3000 port.
# The app is reached as localhost:3000 (it listens on [::1]; see wikitours.service).
{
	# No admin API: no local process (build scripts, the app) can reconfigure Caddy or read its
	# keys through it. Config changes need `systemctl restart caddy` (a reload uses the API).
	admin off
}

(app) {
	# Vercel refused request bodies over 4.5 MB before the app saw them; keep a similar ceiling.
	request_body {
		max_size 5MB
	}
	# The app trusts Vercel's geo headers; a client must not be able to send them through.
	request_header -X-Vercel-Ip-Country
	request_header -X-Vercel-Ip-Country-Region
	request_header -X-Vercel-Ip-City
	# Vercel never exposed Next's internal rewrite header (it names the /admin rewrite).
	header -X-Middleware-Rewrite
	encode zstd gzip
	reverse_proxy localhost:3000
}

www.wikitours.ma {
	redir https://wikitours.ma{uri} 301
}

wikitours.ma, admin.wikitours.ma, bab-makka.com, www.bab-makka.com, m.bab-makka.com {
	import app
	log {
		output file /var/log/caddy/wikitours-access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}

# The Hostinger name keeps working, never indexed, for direct checks of the server.
srv2062670.hstgr.cloud {
	header X-Robots-Tag "noindex, nofollow"
	import app
}
