# PRODUCTION mode (after the DNS cut-over). Copy to /etc/caddy/Caddyfile, then
#   touch /etc/caddy/.wikitours-production && systemctl reload caddy
# Caddy gets and renews the Let's Encrypt certificates for every hostname by itself.
# Every host goes to the Next.js server: the middleware already does www → apex (308),
# admin.wikitours.ma → /admin, and bab-makka.com (+ www, m) → wikitours.ma/fr/… (one 301).
{
	admin localhost:2019
}

wikitours.ma, www.wikitours.ma, admin.wikitours.ma, bab-makka.com, www.bab-makka.com, m.bab-makka.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
	log {
		output file /var/log/caddy/wikitours-access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}

# The Hostinger name keeps working, never indexed, for direct checks of the server.
srv2062670.hstgr.cloud {
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
