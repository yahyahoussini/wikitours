[Unit]
Description=wikitours.ma cron job %i (replaces Vercel Cron; vercel.json schedules, UTC)
After=wikitours.service

[Service]
Type=oneshot
User=wikitours
Group=wikitours
EnvironmentFile=/etc/wikitours/env
ExecStart=/usr/local/bin/wikitours-cron %i
# Up to 1 min waiting for the app (boot catch-up) + the 330 s request.
TimeoutStartSec=8min
