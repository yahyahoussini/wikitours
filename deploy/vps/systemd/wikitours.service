# --hostname localhost (not 127.0.0.1), on purpose: Next 15 builds its own request origin from this
# hostname, while request.nextUrl normalises 127.0.0.1 to "localhost". When both say localhost, the
# origins match, so Next turns every middleware redirect into a RELATIVE Location (/fr) and every
# rewrite (admin.wikitours.ma → /admin) into an internal one. With 127.0.0.1 they leaked
# https://localhost:3000/… and the admin rewrite was proxied over TLS (500). Verified 2026-10-14.
# On this image localhost resolves to ::1, so the app listens on [::1]:3000; callers use localhost:3000.
[Unit]
Description=wikitours.ma Next.js server (localhost:3000, behind Caddy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wikitours
Group=wikitours
EnvironmentFile=/etc/wikitours/env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
WorkingDirectory=/srv/wikitours/current
ExecStart=/usr/bin/node /srv/wikitours/current/node_modules/next/dist/bin/next start --hostname localhost --port 3000
Restart=always
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Writable for the app: only the LIVE release (Next's ISR and fetch cache live in .next) and the
# shared image cache. systemd resolves the `current` symlink at every start, so the git mirror, the
# other releases (the rollback targets) and `current` itself stay read-only for this internet-facing
# process: code run through an app bug cannot change what the next deploy builds. Verified 2026-10-15.
ReadWritePaths=/srv/wikitours/current -/srv/wikitours/shared

[Install]
WantedBy=multi-user.target
