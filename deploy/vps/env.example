# /etc/wikitours/env on the VPS — mode 640, owner root:wikitours. Real values never go in git.
# The same six variables Vercel had (Production), plus DEPLOY_ENV. One KEY=value per line, no quotes.
NEXT_PUBLIC_SITE_URL=https://wikitours.ma
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
CRON_SECRET=
DEPLOY_ENV=production
